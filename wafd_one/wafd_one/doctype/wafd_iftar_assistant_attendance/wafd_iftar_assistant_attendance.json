{
  "doctype": "DocType",
  "name": "WAFD Iftar Assistant Attendance",
  "module": "WAFD ONE",
  "istable": 1,
  "editable_grid": 1,
  "engine": "InnoDB",
  "fields": [
    {
      "fieldname": "assistant_name",
      "fieldtype": "Data",
      "label": "اسم المساعد / Assistant Name",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "mobile_no",
      "fieldtype": "Data",
      "label": "الجوال / Mobile",
      "in_list_view": 1
    },
    {
      "fieldname": "attendance_status",
      "fieldtype": "Select",
      "label": "الحالة / Status",
      "options": "حاضر / Present\nغائب / Absent",
      "default": "حاضر / Present",
      "in_list_view": 1
    },
    {
      "fieldname": "check_in_time",
      "fieldtype": "Time",
      "label": "وقت الحضور / Check-in"
    },
    {
      "fieldname": "check_out_time",
      "fieldtype": "Time",
      "label": "وقت الانصراف / Check-out"
    },
    {
      "fieldname": "signature",
      "fieldtype": "Attach Image",
      "label": "التوقيع / Signature"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "ملاحظات / Notes"
    }
  ],
  "permissions": [],
  "sort_field": "idx",
  "sort_order": "ASC"
}