  },
  {
   "fieldname": "sign_section",
   "fieldtype": "Section Break",
   "label": "التوقيعات / Signatures"
  },
  {
   "fieldname": "delivered_by",
   "fieldtype": "Data",
   "label": "سلّم بواسطة / Delivered By"
