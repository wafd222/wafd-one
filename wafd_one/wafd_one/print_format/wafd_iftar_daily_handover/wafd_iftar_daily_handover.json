 "html": "<style>\n@page { size: A4 portrait; margin: 9mm 9mm 9mm 9mm; }\nhtml, body { margin: 0 !important; padding: 0 !important; }\n.print-format {\n  display: block !important;\n  flex: none !important;\n  width: auto !important;\n  min-height: 0 !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  color: #20242a !important;\n  background: #fff !important;\n  font-family: Arial, Tahoma, sans-serif !important;\n  font-size: 9pt !important;\n  line-height: 1.28 !important;\n}\n.print-format * { box-sizing: border-box !important; }\n.print-format p, .print-format h1, .print-format h2, .print-format h3 { margin-top: 0 !important; }\n.wf { direction: rtl !important; width: 100% !important; max-width: 100% !important; display: block !important; }\n.wf table { width: 100% !important; max-width: 100% !important; border-collapse: collapse !important; border-spacing: 0 !important; table-layout: fixed !important; margin: 0 !important; }\n.wf th, .wf td { border: 0.25mm solid #cfd3d8 !important; padding: 1.6mm 1.8mm !important; vertical-align: middle !important; font-size: 9pt !important; line-height: 1.25 !important; }\n.wf th { background: #f0f1f3 !important; font-weight: 700 !important; }\n.wf .head { margin: 0 0 2.4mm 0 !important; }\n.wf .head td { border: 0 !important; border-bottom: 0.45mm solid #a68135 !important; padding: 0 0 2.3mm 0 !important; }\n.wf .logo { width: 15mm !important; height: auto !important; max-height: 16mm !important; display: inline-block !important; }\n.wf .title { text-align: center !important; margin: 2.5mm 0 3mm 0 !important; }\n.wf .title h2 { font-size: 15pt !important; line-height: 1.2 !important; margin: 0 0 0.8mm 0 !important; font-weight: 700 !important; }\n.wf .muted { color: #6b7280 !important; font-size: 8.5pt !important; }\n.wf .section { background: #eceef1 !important; font-weight: 700 !important; padding: 1.5mm 1.8mm !important; margin: 2.4mm 0 0 0 !important; }\n.wf .gap { height: 2.4mm !important; }\n.wf .sign { margin-top: 4mm !important; page-break-inside: avoid !important; }\n.wf .sign td { border: 0 !important; padding: 0 8mm !important; text-align: center !important; vertical-align: top !important; width: 50% !important; }\n.wf .sig-line { border-top: 0.3mm solid #333 !important; width: 42mm !important; max-width: 80% !important; height: 0 !important; margin: 9mm auto 1.3mm auto !important; }\n.wf .nowrap { white-space: nowrap !important; }\n.wf tr { page-break-inside: avoid !important; }\n.wf thead { display: table-header-group !important; }\n.wf tfoot { display: table-footer-group !important; }\n.wf .avoid { page-break-inside: avoid !important; }\n@media screen, print {\n  .print-format { display: block !important; flex-direction: initial !important; }\n  .wf { display: block !important; }\n}\n</style>{% set project=frappe.get_doc('WAFD Iftar Project',doc.project) %}\n<div class=\"wf\">\n<table class=\"head\"><tr>\n<td style=\"width:78%;\"><b>شركة وفد المدينة لخدمات الإعاشة</b><br><span class=\"muted\">WAFD AL-MADINAH CATERING SERVICES</span></td>\n<td style=\"width:22%;text-align:left;\"><img class=\"logo\" src=\"/assets/wafd_one/images/wafd-almadinah-official.png\"></td>\n</tr></table>\n<div class=\"title\"><h2>نموذج التسليم والاستلام اليومي — إفطار صائم</h2><div class=\"muted\">{{ doc.name }}</div></div>\n<table class=\"avoid\"><colgroup><col style=\"width:16%\"><col style=\"width:34%\"><col style=\"width:16%\"><col style=\"width:34%\"></colgroup>\n<tr><th>المشروع</th><td>{{ project.project_title or doc.project }}</td><th>التاريخ</th><td>{{ doc.operation_date }}</td></tr>\n<tr><th>الموقع</th><td>{{ project.distribution_site or '' }}</td><th>المستلم</th><td>{{ doc.recipient_name or '' }}</td></tr>\n<tr><th>رقم الهوية</th><td>{{ doc.recipient_id or '' }}</td><th>المركبة / السائق</th><td>{{ doc.vehicle or '' }}{% if doc.vehicle and doc.driver_name %} — {% endif %}{{ doc.driver_name or '' }}</td></tr>\n<tr><th>المشرف</th><td>{{ doc.supervisor_name or '' }}</td><th>صاحب السفرة</th><td>{{ doc.table_owner_name or '' }}</td></tr>\n</table>\n<div class=\"gap\"></div>\n<table class=\"avoid\"><tr><th>المخطط</th><th>الإنتاج</th><th>التغليف</th><th>التحميل</th><th>التسليم</th><th>الاستلام</th></tr>\n<tr style=\"text-align:center;\"><td>{{ doc.planned_meals or 0 }}</td><td>{{ doc.produced_meals or 0 }}</td><td>{{ doc.packaged_meals or 0 }}</td><td>{{ doc.loaded_meals or 0 }}</td><td>{{ doc.delivered_meals or 0 }}</td><td>{{ doc.received_meals or 0 }}</td></tr></table>\n<div class=\"gap\"></div>\n<table class=\"avoid\"><colgroup><col style=\"width:16%\"><col style=\"width:34%\"><col style=\"width:16%\"><col style=\"width:34%\"></colgroup>\n<tr><th>الفائض</th><td>{{ doc.surplus_meals or 0 }}</td><th>التالف</th><td>{{ doc.waste_meals or 0 }}</td></tr>\n<tr><th>حفظ النعمة</th><td>{{ doc.preservation_society_quantity or 0 }}</td><th>وقت الاستلام</th><td>{{ doc.receipt_time or '' }}</td></tr>\n<tr><th>الملاحظات</th><td colspan=\"3\">{{ doc.notes or 'لا توجد ملاحظات' }}</td></tr>\n</table>\n<table class=\"sign avoid\"><tr>\n<td><div class=\"sig-line\"></div><b>المسلِّم</b><br>{{ doc.delivered_by or '' }}</td>\n<td><div class=\"sig-line\"></div><b>المستلم</b><br>{{ doc.received_by or doc.recipient_name or '' }}</td>\n</tr></table>\n</div>",
