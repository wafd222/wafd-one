 "html": "<style>@page{size:A4;margin:11mm}.print-format{font-family:Tahoma,Arial,sans-serif;color:#172033;font-size:10px}.hdr{display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #b38a3e;padding-bottom:7px;margin-bottom:12px}.hdr img{width:25mm;height:22mm;object-fit:contain}.hdr h1{font-size:18px;margin:0;color:#172033}.muted{color:#64748b}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:10px 0}.kpi{border:1px solid #dfe3e8;border-radius:7px;padding:7px;text-align:center}.kpi b{display:block;font-size:15px}.tbl{width:100%;border-collapse:collapse;margin-top:9px}.tbl th,.tbl td{border:1px solid #cfd5dc;padding:6px;text-align:center}.tbl th{background:#f2f4f7}.sign{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-top:28px;text-align:center}.box{border:1px solid #cfd5dc;border-radius:7px;padding:8px;margin:8px 0}.rtl{direction:rtl;text-align:right}</style><div class='hdr'><div class='rtl'><h1>ملخص مشروع إفطار صائم / Iftar Project Summary</h1><div class='muted'>شركة وفد المدينة لخدمات الإعاشة<br>WAFD AL-MADINAH CATERING SERVICES</div></div><img src='/assets/wafd_one/images/wafd-almadinah-official.png'></div><div class='box rtl'><b>المشروع:</b> {{ doc.project_title }} &nbsp; | &nbsp; <b>الموقع:</b> {{ doc.distribution_site }}<br><b>الفترة:</b> {{ doc.get_formatted('start_date') }} — {{ doc.get_formatted('end_date') }} &nbsp; | &nbsp; <b>الجهة:</b> {{ doc.contracting_entity }}</div><div class='kpis'><div class='kpi'>الوجبات اليومية<b>{{ doc.daily_meals }}</b></div><div class='kpi'>عدد الأيام<b>{{ doc.number_of_days }}</b></div><div class='kpi'>إجمالي الوجبات<b>{{ doc.total_meals }}</b></div><div class='kpi'>الربح المتوقع<b>{{ frappe.utils.fmt_money(doc.expected_profit or 0) }}</b></div></div><table class='tbl rtl'><tr><th>المادة</th><th>الكمية/وجبة</th><th>الوحدة</th><th>التكلفة/وجبة</th></tr>{% for r in doc.components %}<tr><td>{{ r.ingredient }}</td><td>{{ r.quantity_per_meal }}</td><td>{{ r.uom or '' }}</td><td>{{ frappe.utils.fmt_money(r.cost_per_meal or 0) }}</td></tr>{% endfor %}</table>",
