{
 "doctype": "Print Format",
 "name": "WAFD Iftar Supervisor Receipt",
 "doc_type": "WAFD Iftar Daily Operation",
 "module": "WAFD ONE",
 "custom_format": 1,
 "print_format_type": "Jinja",
 "standard": "Yes",
 "disabled": 0,
 "html": "<style>\n@page { size: A4 portrait; margin: 9mm 9mm 9mm 9mm; }\nhtml, body { margin: 0 !important; padding: 0 !important; }\n.print-format {\n  display: block !important;\n  flex: none !important;\n  width: auto !important;\n  min-height: 0 !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  color: #20242a !important;\n  background: #fff !important;\n  font-family: Arial, Tahoma, sans-serif !important;\n  font-size: 9pt !important;\n  line-height: 1.28 !important;\n}\n.print-format * { box-sizing: border-box !important; }\n.print-format p, .print-format h1, .print-format h2, .print-format h3 { margin-top: 0 !important; }\n.wf { direction: rtl !important; width: 100% !important; max-width: 100% !important; display: block !important; }\n.wf table { width: 100% !important; max-width: 100% !important; border-collapse: collapse !important; border-spacing: 0 !important; table-layout: fixed !important; margin: 0 !important; }\n.wf th, .wf td { border: 0.25mm solid #cfd3d8 !important; padding: 1.6mm 1.8mm !important; vertical-align: middle !important; font-size: 9pt !important; line-height: 1.25 !important; }\n.wf th { background: #f0f1f3 !important; font-weight: 700 !important; }\n.wf .head { margin: 0 0 2.4mm 0 !important; }\n.wf .head td { border: 0 !important; border-bottom: 0.45mm solid #a68135 !important; padding: 0 0 2.3mm 0 !important; }\n.wf .logo { width: 15mm !important; height: auto !important; max-height: 16mm !important; display: inline-block !important; }\n.wf .title { text-align: center !important; margin: 2.5mm 0 3mm 0 !important; }\n.wf .title h2 { font-size: 15pt !important; line-height: 1.2 !important; margin: 0 0 0.8mm 0 !important; font-weight: 700 !important; }\n.wf .muted { color: #6b7280 !important; font-size: 8.5pt !important; }\n.wf .section { background: #eceef1 !important; font-weight: 700 !important; padding: 1.5mm 1.8mm !important; margin: 2.4mm 0 0 0 !important; }\n.wf .gap { height: 2.4mm !important; }\n.wf .sign { margin-top: 4mm !important; page-break-inside: avoid !important; }\n.wf .sign td { border: 0 !important; padding: 0 8mm !important; text-align: center !important; vertical-align: top !important; width: 50% !important; }\n.wf .sig-line { border-top: 0.3mm solid #333 !important; width: 42mm !important; max-width: 80% !important; height: 0 !important; margin: 9mm auto 1.3mm auto !important; }\n.wf .nowrap { white-space: nowrap !important; }\n.wf tr { page-break-inside: avoid !important; }\n.wf thead { display: table-header-group !important; }\n.wf tfoot { display: table-footer-group !important; }\n.wf .avoid { page-break-inside: avoid !important; }\n@media screen, print {\n  .print-format { display: block !important; flex-direction: initial !important; }\n  .wf { display: block !important; }\n}\n</style>{% set project=frappe.get_doc('WAFD Iftar Project',doc.project) %}\n<div class=\"wf\">\n<table class=\"head\"><tr><td style=\"width:78%;\"><b>شركة وفد المدينة لخدمات الإعاشة</b><br><span class=\"muted\">WAFD AL-MADINAH CATERING SERVICES</span></td><td style=\"width:22%;text-align:left;\"><img class=\"logo\" src=\"/assets/wafd_one/images/wafd-almadinah-official.png\"></td></tr></table>\n<div class=\"title\"><h2>كشف استلام المشرف وحضور المساعدين</h2><div class=\"muted\">{{ doc.name }}</div></div>\n<table class=\"avoid\"><colgroup><col style=\"width:16%\"><col style=\"width:34%\"><col style=\"width:16%\"><col style=\"width:34%\"></colgroup>\n<tr><th>المشروع</th><td>{{ project.project_title or doc.project }}</td><th>التاريخ</th><td>{{ doc.operation_date }}</td></tr>\n<tr><th>صاحب السفرة</th><td>{{ doc.table_owner_name or '' }}</td><th>المشرف</th><td>{{ doc.supervisor_name or '' }}</td></tr>\n<tr><th>مدير المشرفين</th><td>{{ doc.supervisors_manager or '' }}</td><th>عدد الوجبات</th><td>{{ doc.assigned_meals or doc.planned_meals or 0 }}</td></tr>\n</table>\n<div class=\"gap\"></div>\n<table><thead><tr><th style=\"width:7%\">#</th><th>اسم المساعد</th><th style=\"width:15%\">حاضر</th><th style=\"width:15%\">غائب</th><th style=\"width:28%\">ملاحظات</th></tr></thead><tbody>\n{% for row in doc.assistants_attendance %}<tr><td>{{ loop.index }}</td><td>{{ row.assistant_name or '' }}</td><td style=\"text-align:center\">{% if row.is_present %}✓{% endif %}</td><td style=\"text-align:center\">{% if not row.is_present %}✓{% endif %}</td><td>{{ row.notes or '' }}</td></tr>{% endfor %}\n{% if not doc.assistants_attendance %}{% for i in range(15) %}<tr><td>{{ i+1 }}</td><td>&nbsp;</td><td></td><td></td><td></td></tr>{% endfor %}{% endif %}\n</tbody></table>\n<table class=\"sign avoid\"><tr><td><div class=\"sig-line\"></div><b>توقيع المشرف</b></td><td><div class=\"sig-line\"></div><b>اعتماد مدير المشرفين</b></td></tr></table>\n</div>",
 "raw_printing": 0,
 "align_labels_right": 1,
 "show_section_headings": 1,
 "line_breaks": 0,
 "absolute_value": 0,
 "font": "Default",
 "page_number": "Hide",
 "print_format_builder": 0,
 "default_print_language": "ar",
 "letter_head": null,
 "margin_top": 0,
 "margin_bottom": 0,
 "margin_left": 0,
 "margin_right": 0,
 "css": ""
}
