{
 "doctype": "Print Format",
 "name": "WAFD Iftar Supervisor Receipt",
 "doc_type": "WAFD Iftar Daily Operation",
 "module": "WAFD ONE",
 "custom_format": 1,
 "print_format_type": "Jinja",
 "standard": "Yes",
 "disabled": 0,
 "html": "<style>@page{size:A4 portrait;margin:8mm}.print-format{margin:0!important;padding:0!important;font-family:Tahoma,Arial,sans-serif;font-size:9pt;line-height:1.25;color:#20242a}.wf{direction:rtl;width:100%}.wf table{width:100%;border-collapse:collapse;table-layout:fixed}.wf th,.wf td{border:1px solid #cfd3d8;padding:5px;vertical-align:middle}.wf th{background:#f0f1f3}.wf .head td{border:0;border-bottom:1.5px solid #a68135}.wf .logo{width:55px;max-height:55px}.wf .title{text-align:center;margin:8px 0}.wf .title h2{font-size:16px;margin:0}.wf .muted{color:#6b7280}.wf .section{background:#eceef1;font-weight:bold}.wf .sign td{border:0;text-align:center;padding-top:20px}.wf .line{border-top:1px solid #333;width:65%;margin:22px auto 3px}.wf table,.wf tr,.wf td,.wf th,.wf .keep{page-break-inside:avoid!important;break-inside:avoid!important}</style>{% set project=frappe.get_doc('WAFD Iftar Project',doc.project) %}<div class='wf'><table class='head'><tr><td><b>شركة وفد المدينة لخدمات الإعاشة</b><br><span class='muted'>WAFD AL-MADINAH CATERING SERVICES</span></td><td style='text-align:left'><img class='logo' src='/assets/wafd_one/images/wafd-almadinah-official.png'></td></tr></table><div class='title'><h2>كشف استلام المشرف وحضور المساعدين</h2><div class='muted'>{{ doc.name }}</div></div><table><tr><th>المشروع</th><td>{{ project.project_title or doc.project }}</td><th>التاريخ</th><td>{{ doc.operation_date }}</td></tr><tr><th>صاحب السفرة</th><td>{{ doc.table_owner_name or '' }}</td><th>المشرف</th><td>{{ doc.supervisor_name or '' }}</td></tr><tr><th>مدير المشرفين</th><td>{{ doc.supervisors_manager or '' }}</td><th>عدد الوجبات</th><td>{{ doc.assigned_meals or doc.planned_meals or 0 }}</td></tr></table><table style='margin-top:7px'><tr><th style='width:7%'>#</th><th>اسم المساعد</th><th style='width:16%'>حاضر</th><th style='width:16%'>غائب</th><th>ملاحظات</th></tr>{% for row in doc.assistants_attendance %}<tr><td>{{ loop.index }}</td><td>{{ row.assistant_name or '' }}</td><td>{% if row.is_present %}✓{% endif %}</td><td>{% if not row.is_present %}✓{% endif %}</td><td>{{ row.notes or '' }}</td></tr>{% endfor %}{% if not doc.assistants_attendance %}{% for i in range(15) %}<tr><td>{{ i+1 }}</td><td>&nbsp;</td><td></td><td></td><td></td></tr>{% endfor %}{% endif %}</table><table class='sign'><tr><td><div class='line'></div>توقيع المشرف</td><td><div class='line'></div>اعتماد مدير المشرفين</td></tr></table></div>",
 "raw_printing": 0,
 "align_labels_right": 1,
 "show_section_headings": 1,
 "line_breaks": 0,
 "absolute_value": 0,
 "font": "Default",
 "page_number": "Hide",
 "print_format_builder": 0,
 "default_print_language": "ar",
 "letter_head": null,
 "margin_top": 0,
 "margin_bottom": 0,
 "margin_left": 0,
 "margin_right": 0
}
