 "html": "<div dir=\"rtl\" style=\"font-family:Tahoma,Arial,sans-serif;color:#222;font-size:11px;padding:10mm 9mm;\">\n<div style=\"text-align:center;border-bottom:2px solid #b69a61;padding-bottom:10px;margin-bottom:12px\"><div style=\"font-size:17px;font-weight:700\">شركة وفد المدينة لخدمات الإعاشة</div><div style=\"font-size:10px;color:#666\">WAFD AL-MADINAH CATERING SERVICES</div></div>\n<h2 style=\"text-align:center;margin:8px 0 3px\">خطة المشرف وأصحاب السفر والمساعدين</h2><div style=\"text-align:center;color:#777;margin-bottom:12px\">{{ doc.name }}</div>\n{% set project = frappe.get_doc('WAFD Iftar Project', doc.project) %}\n<table style=\"width:100%;border-collapse:collapse;margin-bottom:10px\"><tr><td style=\"border:1px solid #ccc;padding:6px\"><b>المشروع:</b> {{ project.project_title }}</td><td style=\"border:1px solid #ccc;padding:6px\"><b>رقم المشروع:</b> {{ doc.project }}</td></tr><tr><td style=\"border:1px solid #ccc;padding:6px\"><b>الموقع:</b> {{ doc.distribution_site or project.distribution_site }}</td><td style=\"border:1px solid #ccc;padding:6px\"><b>الفترة:</b> {{ project.get_formatted('start_date') }} — {{ project.get_formatted('end_date') }}</td></tr>{% if doc.haram_zone %}<tr><td colspan=\"2\" style=\"border:1px solid #ccc;padding:6px\"><b>منطقة الحرم المعتمدة:</b> {{ frappe.db.get_value('WAFD Iftar Haram Zone', doc.haram_zone, 'location_name') or doc.haram_zone }}</td></tr>{% endif %}</table>\n<table style=\"width:100%;border-collapse:collapse;margin-bottom:12px\"><tr><td style=\"border:1px solid #ccc;padding:7px\"><b>مدير المشرفين:</b> {{ doc.manager_name or '' }}</td><td style=\"border:1px solid #ccc;padding:7px\"><b>المشرف:</b> {{ doc.supervisor_name or '' }}</td><td style=\"border:1px solid #ccc;padding:7px\"><b>الجوال:</b> {{ doc.supervisor_mobile or '' }}</td></tr><tr><td style=\"border:1px solid #ccc;padding:7px\"><b>إجمالي الوجبات:</b> {{ doc.assigned_meals or 0 }}</td><td style=\"border:1px solid #ccc;padding:7px\"><b>أصحاب السفر:</b> {{ doc.table_owners_count or 0 }}</td><td style=\"border:1px solid #ccc;padding:7px\"><b>المساعدون:</b> {{ doc.assistants_count or 0 }}</td></tr></table>\n<div style=\"font-weight:700;background:#f1eee8;border-right:4px solid #b69a61;padding:6px;margin:8px 0\">أصحاب السفر المكلف بهم المشرف</div>\n<table style=\"width:100%;border-collapse:collapse\"><thead><tr>{% for h in ['م','صاحب السفرة','الجوال','نقطة التوزيع','الموقع التفصيلي','الوجبات'] %}<th style=\"border:1px solid #bbb;padding:5px;background:#f7f7f7\">{{ h }}</th>{% endfor %}</tr></thead><tbody>{% for r in doc.table_owners or [] %}<tr><td style=\"border:1px solid #ccc;padding:5px;text-align:center\">{{ loop.index }}</td><td style=\"border:1px solid #ccc;padding:5px\">{{ r.table_owner_name or '' }}</td><td style=\"border:1px solid #ccc;padding:5px\">{{ r.mobile_no or '' }}</td><td style=\"border:1px solid #ccc;padding:5px\">{{ r.distribution_point or '' }}</td><td style=\"border:1px solid #ccc;padding:5px\">{{ r.delivery_location or '' }}</td><td style=\"border:1px solid #ccc;padding:5px;text-align:center\">{{ r.meal_quantity or 0 }}</td></tr>{% endfor %}</tbody></table>\n<div style=\"font-weight:700;background:#f1eee8;border-right:4px solid #b69a61;padding:6px;margin:12px 0 8px\">المساعدون — العدد مفتوح حسب الحاجة التشغيلية</div>\n<table style=\"width:100%;border-collapse:collapse\"><thead><tr><th style=\"border:1px solid #bbb;padding:5px;background:#f7f7f7;width:8%\">م</th><th style=\"border:1px solid #bbb;padding:5px;background:#f7f7f7\">اسم المساعد</th><th style=\"border:1px solid #bbb;padding:5px;background:#f7f7f7;width:28%\">الجوال</th><th style=\"border:1px solid #bbb;padding:5px;background:#f7f7f7;width:15%\">نشط</th></tr></thead><tbody>{% for r in doc.assistants or [] %}<tr><td style=\"border:1px solid #ccc;padding:5px;text-align:center\">{{ loop.index }}</td><td style=\"border:1px solid #ccc;padding:5px\">{{ r.assistant_name or '' }}</td><td style=\"border:1px solid #ccc;padding:5px\">{{ r.mobile_no or '' }}</td><td style=\"border:1px solid #ccc;padding:5px;text-align:center\">{{ 'نعم' if r.active else 'لا' }}</td></tr>{% endfor %}</tbody></table>\n<div style=\"display:flex;gap:50px;margin-top:24px\"><div style=\"flex:1;text-align:center\">المشرف<div style=\"border-bottom:1px solid #555;height:26px\"></div>{{ doc.supervisor_name or '' }}</div><div style=\"flex:1;text-align:center\">مدير المشرفين<div style=\"border-bottom:1px solid #555;height:26px\"></div>{{ doc.manager_name or '' }}</div></div>\n<div style=\"margin-top:18px;text-align:center;color:#888;font-size:9px;border-top:1px solid #ddd;padding-top:6px\">مستند إلكتروني صادر من نظام WAFD ONE — تسجل الخطة مرة واحدة للمشروع وتستخدم خلال أيام التشغيل مع تعديل التغييرات فقط.</div>\n</div>",
